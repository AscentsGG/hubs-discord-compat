{
  "name": "hubs-discord-compat",
  "version": "0.3.0",
  "description": "Run a discord.js bot on Hubs: the common discord.js surface on top of the Hubs bot gateway and developer API.",
  "keywords": [
    "hubs",
    "bot",
    "discord.js",
    "slash-commands",
    "gateway"
  ],
  "homepage": "https://github.com/AscentsGG/hubs-discord-compat#readme",
  "bugs": {
    "url": "https://github.com/AscentsGG/hubs-discord-compat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AscentsGG/hubs-discord-compat.git"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json",
    "test": "tsx --test test/*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
